parameters:
	ignoreErrors:
		-
			message: '#^Variable \$command might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: repo/src/Illuminate/Database/Console/DbCommand.php

		-
			message: '#^Variable \$action on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: repo/src/Illuminate/Foundation/Console/RouteListCommand.php

		-
			message: '#^Variable \$shouldRetry on left side of \?\? always exists and is always null\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: repo/src/Illuminate/Http/Client/PendingRequest.php
